# Reference sources kept locally only — third-party dumps, not part of the product.
# `_handover/` holds the copies the user handed over for reading (MiniMax Code, older
# DS.IDE snapshots); they are never published, and 80 MB of another product's source must
# not end up in an MIT repository.
_handover/
.kilo/

kilocode-main/
minimax-code-main/
minimax-jarvis/
monaco-editor-0.57.0/

# Font source drop — the used cuts are copied into public/fonts (with UFL.txt)
Ubuntu/

# Local secrets fallback (the key belongs in the OS keyring)
src-tauri/secrets.json


# Local list for scripts/check-private.mjs — never published
.private-names

# Build products of the Flatpak
/target/

